# Terraform local state and artifacts
# NOTE: .terraform.lock.hcl is intentionally NOT ignored: commit it for reproducible provider versions.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files may contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Environment & sensitive files
*.pem
*.key
.env
